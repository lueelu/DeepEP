        "event"
      ]
    },
    "ElasticBuffer.dispatch": {
      "returns": [
        "recv_x",
        "recv_topk_idx",
        "recv_topk_weights",
        "handle",
        "event"
      ],
      "unexpanded": {
        "supported": false,
        "x": "[N,H]",
        "topk_idx": "[N,K]",
        "weights": "[N,K] or None"
      },
      "expanded": {
        "x": "[R,H]",
        "topk_idx": null,
        "weights": "[R] or None"
      }
    },
    "ElasticBuffer.combine": {
      "returns": [
        "combined_x",
        "combined_topk_weights",
        "event"
      ],
      "x": "[T,H]",
      "weights": "[T,K] or None",
      "weight_semantics": "HT returns independent FP32 route values without multiplying x; LL applies the saved source weights and returns no weights."
    },
    "EPHandle": {
      "caller_fields": [
        "do_expand",
        "num_experts",
        "num_max_tokens_per_rank",
        "num_recv_tokens_per_expert_list"
      ],
      "ownership": "Routing plan belongs to one buffer and survives until the matching backward/recompute finishes.",
      "metadata_version": 7,
      "forward_list": {
        "shape": "[world_size,T*K,6]",
        "dtype": "int32",
        "fields": [
          "token_end",
          "token_id",
          "primary_row",
          "secondary_rank",
          "secondary_row",
          "gather_row"
        ],
        "token_end": "Exclusive row end within the source partition, repeated on every row of the same token."
      },
      "backward_list_order": [
        "token_chunk",
        "gateway_group",
        "src_rank",
        "gather_row"
      ],
      "weight_return_meta": {
        "shape": "[num_expanded_tokens]",
        "dtype": "int32",
        "encoding": "(src_rank * T + token_id) * K + topk_id",
        "topk_id": "Original top-k position, not expert ID.",
        "storage": "View of framework-owned [world_size*T*K] storage; cached routing must remain unchanged."
      }
    },
    "events": {
      "Buffer.capture": "EventOverlap",
      "ElasticBuffer.capture": "EventHandle",
      "rule": "Normalize only EventOverlap wrappers; never unwrap EventHandle a second time."
    }
  },
