  "contract": "EP declarations adapted from the cited upstream sources, not an exact upstream signature snapshot.",
  "platform_naming": {
    "scaleup": "Intra-domain transport; no particular interconnect implementation is implied.",
    "scaleout": "Inter-domain transport; no particular interconnect implementation is implied.",
    "memory_transport": "Memory-semantic transport only, not all scale-up backends; flags do not establish capability.",
    "qps": "Backend-specific queue-pair hints; HT uses fixed shared-jetty scheduling, not an arbitrary DMA channel count.",
    "compute_units": "num_sms and num_compute_units both count AIVs; no AI-core conversion or change in scheduling.",
    "device": "NPU execution, timeout and reference-capture terminology.",
    "aligned_col_major_sf": "Reserved scale-factor layout option; no implementation or alignment capability is implied.",
    "compatibility": "Upstream public names plus existing Ascend keyword aliases; conflicting values are rejected. Argument order and defaults are unchanged."
  },
