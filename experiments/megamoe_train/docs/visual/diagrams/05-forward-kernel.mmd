flowchart TB
  subgraph lane_f_all["全核协调 / 所有 AIV"]
    f_select["选择 H7168 的 UB 前向路径"]
    f_routes["在源 rank 生成排序 route 行"]
    f_route_p["让 p 与排序 X 一一对应"]
    f_counts["交换计数，确定专家接收地址"]
    f_ready_policy["逐专家决定 row-ready 或整专家等待"]
    f_unpermute["源 rank 按 token 累加各 route"]
    f_exit["所有源 rank 读完 ptrD 才退出"]
  end
  subgraph lane_f_aiv1["AIV1：Dispatch / Combine"]
    f_dispatch_x["拉取当前 fragment 的 token 行"]
    f_dispatch_p["拉取同一 fragment 的路由权重"]
    f_publish_ready["X 与 p 可见后发布 ready"]
    f_release_dispatch_ub["AIV1 释放 Dispatch 的 UB"]
    f_combine["将专家 tile 拆片回传源 rank"]
  end
  subgraph lane_f_aic["AIC：矩阵计算"]
    f_wait_xp["按本任务的真实输入等待"]
    f_gate_up["同一个 X tile 分别计算 Gate 和 Up"]
    f_gmm2_wait["等当前专家全部 Hp 可见"]
    f_gmm2["GMM2 输出到 AIV1 的双 UB 槽"]
  end
  subgraph lane_f_aiv0["AIV0：保存 / SwiGLU"]
    f_save_raw["保存原始 Gate / Up 给反向"]
    f_swiglu_p["SwiGLU 后逐行乘路由 p"]
    f_publish_hp["写 GMM2 输入并发布本专家计数"]
  end
  f_select --> f_routes
  f_routes --> f_route_p
  f_route_p -.-> f_counts
  f_counts --> f_ready_policy
  f_ready_policy --> f_dispatch_x
  f_dispatch_x --> f_dispatch_p
  f_dispatch_p -.-> f_publish_ready
  f_publish_ready -.-> f_wait_xp
  f_wait_xp --> f_gate_up
  f_gate_up --> f_save_raw
  f_save_raw --> f_swiglu_p
  f_swiglu_p --> f_publish_hp
  f_dispatch_p -.-> f_release_dispatch_ub
  f_release_dispatch_ub -.-> f_gmm2_wait
  f_publish_hp -.-> f_gmm2_wait
  f_gmm2_wait --> f_gmm2
  f_gmm2 --> f_combine
  f_combine -.-> f_unpermute
  f_unpermute -.-> f_exit
