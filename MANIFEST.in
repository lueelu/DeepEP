include VERSION CMakeLists.txt build_support.py dependencies.lock.json
include LICENSE
include .gitmodules
include requirements-dev.txt pytest.ini
include requirements-build.txt
recursive-include cmake *.cmake CMakeLists.txt
recursive-include csrc *.cpp *.hpp *.h *.cmake CMakeLists.txt
recursive-include docs *.md
recursive-include scripts *.py *.sh
recursive-include tests *.py *.json *.cpp *.h *.md
recursive-include benchmarks *.py *.json *.csv *.md
include third-party/*.md third-party/*.LICENSE
prune third-party/shmem
prune third-party/catlass
# DeepJIT is mandatory and needs the locked headers and their notice in the
# sdist; a source checkout can still use the git submodule.
recursive-include third-party/deep_jit/include *.hpp
include third-party/deep_jit/README.md
include third-party/deepjit.LICENSE
recursive-include third-party/fmt/include *.h
include third-party/fmt/LICENSE
include third-party/fmt/README.md
prune deep_ep/.native-build
prune deep_ep/.libs
recursive-exclude deep_ep *.so *.so.*
exclude deep_ep/_build_info.json
recursive-include experiments/megamoe *.sh *.py *.cpp *.hpp *.cmake CMakeLists.txt *.json *.md *.txt *.LICENSE
include experiments/__init__.py
include experiments/ep_gmm_fused/tests/requirements.txt
recursive-include experiments/ep_gmm_fused *.py *.cpp *.hpp *.h *.cmake CMakeLists.txt *.md *.json LICENSE
